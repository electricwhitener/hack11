# Get a free key at https://aistudio.google.com/apikey  (no card required)
GOOGLE_GENERATIVE_AI_API_KEY=

# Model overrides. These WIN over the defaults in src/lib/ai/provider.ts —
# if the agent breaks after a model change, check here first.
# Avoid the *-latest alias for the main model: it tracks Google's newest model,
# which carries the tightest free-tier quota (gemini-3.7-flash allows only 20/min).
MODEL_ID=gemini-3.5-flash
FAST_MODEL_ID=gemini-flash-lite-latest

# minimal | low | medium | high. Lower = faster. Use 'low': 'minimal' is
# rejected outright by gemini-3.7-flash.
THINKING_LEVEL=low

# Python analysis service
PY_SERVICE_URL=http://127.0.0.1:8000

# Database. Local dev works without this until you add a Prisma model.
# Free Postgres: https://supabase.com/dashboard -> Project Settings -> Database
DATABASE_URL=
